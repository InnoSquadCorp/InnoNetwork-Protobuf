{
  "jobs": {
    "build-and-test": {
      "name": "Build and Test",
      "runs-on": "macos-15",
      "timeout-minutes": 45,
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v4"
        },
        {
          "name": "Select Xcode",
          "run": "sudo xcode-select -s /Applications/Xcode_26.0.1.app"
        },
        {
          "name": "Show toolchain versions",
          "run": "xcodebuild -version\nxcrun swift --version\n"
        },
        {
          "name": "Resolve dependencies",
          "run": "xcrun swift package resolve"
        },
        {
          "name": "Build",
          "run": "xcrun swift build"
        },
        {
          "name": "Test",
          "run": "xcrun swift test"
        }
      ]
    },
    "docs-contract-sync": {
      "name": "Docs / Contract Sync",
      "runs-on": "macos-15",
      "timeout-minutes": 30,
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v4"
        },
        {
          "name": "Select Xcode",
          "run": "sudo xcode-select -s /Applications/Xcode_26.0.1.app"
        },
        {
          "name": "Resolve dependencies",
          "run": "xcrun swift package resolve"
        },
        {
          "name": "Verify docs and stability contract",
          "run": "bash Scripts/check_docs_contract_sync.sh"
        },
        {
          "name": "Build documentation smoke target",
          "run": "xcrun swift build --target InnoNetworkProtobufDocSmoke"
        },
        {
          "name": "Run documentation smoke target",
          "run": "xcrun swift run InnoNetworkProtobufDocSmoke"
        }
      ]
    },
    "consumer-smoke": {
      "name": "Consumer Smoke",
      "runs-on": "macos-15",
      "timeout-minutes": 30,
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v4"
        },
        {
          "name": "Select Xcode",
          "run": "sudo xcode-select -s /Applications/Xcode_26.0.1.app"
        },
        {
          "name": "Build consumer smoke package",
          "working-directory": "Examples/ConsumerSmoke",
          "run": "xcrun swift build"
        }
      ]
    }
  },
  "release": {
    "validate-release": {
      "name": "Validate Release",
      "runs-on": "macos-15",
      "timeout-minutes": 60,
      "permissions": {
        "contents": "read"
      },
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ github.event_name == 'workflow_dispatch' && inputs.version || github.ref }}"
          }
        },
        {
          "name": "Select Xcode",
          "run": "sudo xcode-select -s /Applications/Xcode_26.0.1.app"
        },
        {
          "name": "Resolve dependencies",
          "run": "xcrun swift package resolve"
        },
        {
          "name": "Verify docs and stability contract",
          "run": "bash Scripts/check_docs_contract_sync.sh"
        },
        {
          "name": "Build and run documentation smoke target",
          "run": "xcrun swift build --target InnoNetworkProtobufDocSmoke\nxcrun swift run InnoNetworkProtobufDocSmoke\n"
        },
        {
          "name": "Build consumer smoke package",
          "working-directory": "Examples/ConsumerSmoke",
          "run": "xcrun swift build"
        },
        {
          "name": "Run tests",
          "run": "xcrun swift test"
        }
      ]
    },
    "publish-release": {
      "name": "Publish Release",
      "needs": "validate-release",
      "runs-on": "ubuntu-latest",
      "permissions": {
        "contents": "write"
      },
      "steps": [
        {
          "name": "Checkout",
          "uses": "actions/checkout@v4",
          "with": {
            "ref": "${{ github.event_name == 'workflow_dispatch' && inputs.version || github.ref }}"
          }
        },
        {
          "name": "Prepare release notes",
          "id": "notes",
          "shell": "bash",
          "run": "set -euo pipefail\nversion=\"${{ github.event_name == 'workflow_dispatch' && inputs.version || github.ref_name }}\"\nnotes_source=\"docs/releases/${version}.md\"\nnotes_target=\"release-notes.md\"\n\nif [[ -f \"$notes_source\" ]]; then\n  cp \"$notes_source\" \"$notes_target\"\nelse\n  printf '%s\\n' \\\n    \"# InnoNetworkProtobuf ${version}\" \\\n    \"\" \\\n    \"See CHANGELOG.md for the summarized release history.\" > \"$notes_target\"\nfi\n\necho \"version=${version}\" >> \"$GITHUB_OUTPUT\"\necho \"notes_path=${notes_target}\" >> \"$GITHUB_OUTPUT\"\n"
        },
        {
          "name": "Create GitHub Release",
          "uses": "softprops/action-gh-release@v2",
          "with": {
            "tag_name": "${{ github.event_name == 'workflow_dispatch' && inputs.version || github.ref_name }}",
            "name": "InnoNetworkProtobuf ${{ steps.notes.outputs.version }}",
            "body_path": "${{ steps.notes.outputs.notes_path }}"
          }
        }
      ]
    }
  }
}
